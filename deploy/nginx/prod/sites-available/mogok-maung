# ==============================================================================
# /etc/nginx/sites-available/mogok-maung (symlinked into sites-enabled).
#
# Domains (DNS -> VPS IP):
#   mmrodds.com     -> Flutter Web SPA (mobile/build/web) + /admin proxy
#   api.mmrodds.com -> Go REST API on 127.0.0.1:8081 + WSS /ws
#
# The http-level guardrails (rate-limit zones, $admin_gate, $connection_upgrade,
# upstreams, cloudflare real_ip rewrites) live in /etc/nginx/nginx.conf — do NOT
# duplicate zones/maps here.
#
# ONE combined Let's Encrypt cert covers BOTH names (requested by setup-ssl.sh as
# `-d mmrodds.com -d api.mmrodds.com`) under /etc/letsencrypt/live/mmrodds.com/.
# ==============================================================================

# --- HTTP -> HTTPS + ACME challenge -------------------------------------------
server {
    listen 80;
    server_name mmrodds.com api.mmrodds.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

# --- API (api.mmrodds.com) ------------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name api.mmrodds.com;

    ssl_certificate     /etc/letsencrypt/live/mmrodds.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mmrodds.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    client_max_body_size 4m;

    # Auth endpoints rate-limited tightly (credential-stuffing shield).
    location /api/v1/auth/ {
        limit_req zone=auth_zone burst=20 nodelay;
        proxy_pass http://api_backend;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP          $remote_addr;
        proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto  $scheme;
    }

    # Admin control plane — office machines, or verified Tunnel/VPC origin.
    location /api/v1/admin/ {
        if ($admin_gate = 0) { return 403; }
        limit_req zone=api_zone burst=200;
        proxy_pass http://api_backend;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP          $remote_addr;
        proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto  $scheme;
    }

    # Agent dashboard API — also restricted (agents manage money).
    location /api/v1/agent/ {
        if ($admin_gate = 0) { return 403; }
        limit_req zone=api_zone burst=200;
        proxy_pass http://api_backend;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP          $remote_addr;
        proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto  $scheme;
    }

    # User-facing API — lightly rate limited.
    location /api/ {
        limit_req zone=api_zone burst=200;
        proxy_pass http://api_backend;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP          $remote_addr;
        proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto  $scheme;
    }

    # Health probe — 200 "ok" only when the API deems PG + Redis healthy.
    location = /health {
        proxy_pass http://api_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        add_header Cache-Control "no-store, max-age=0" always;
    }

    # WebSocket (live odds + agent request fan-out) — upgrade honored.
    location /ws {
        proxy_pass http://api_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host       $host;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

# --- Main domain (mmrodds.com) — Flutter Web SPA + dashboard --------------------
server {
    listen 443 ssl;
    http2 on;
    server_name mmrodds.com;

    ssl_certificate     /etc/letsencrypt/live/mmrodds.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mmrodds.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    root /opt/mogok-maung/mobile/build/web;
    index index.html;

    # Flutter SPA fallback: serve index.html for client-side routes.
    location / {
        try_files $uri $uri/ /index.html;
    }
    # Long-lived immutable Flutter asset cache (build/web/assets + canvaskit).
    location ~* ^/(assets|canvaskit|icons)/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # Admin dashboard (optional) — served at the /admin path on the main domain.
    location /admin/ {
        proxy_pass http://admin_web;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP          $remote_addr;
        proxy_set_header X-Forwarded-For    $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto  $scheme;
    }

    client_max_body_size 4m;
}