# ==============================================================================
# Mogok Maung — root .gitignore
# ==============================================================================

# --- Secrets & environment (NEVER commit) -------------------------------------
.env
.env.*
!.env.example
!.env.production.example
.aws/credentials
*.pem
*.key
!*.key.tf
secrets/
build/

# --- Terraform state & plan files ----------------------------------------------
infrastructure/terraform/.terraform/
infrastructure/terraform/*.tfstate
infrastructure/terraform/*.tfstate.*
infrastructure/terraform/terraform.tfvars
infrastructure/terraform/crash.log
deploy/nginx/conf.d/admin-dashboard.conf.real
deploy/nginx/conf.d/api-admin-lockdown.conf.real

# --- Go ----------------------------------------------------------------------
bin/
*.test
coverage.out

# --- Web (Next.js) -------------------------------------------------------------
web/node_modules/
web/.next/
web/out/

# --- Flutter / mobile -----------------------------------------------------------
mobile/build/
mobile/.dart_tool/
mobile/android/.gradle/
mobile/ios/Pods/
mobile/ios/.symlinks/

# --- Local tooling ----------------------------------------------------------------
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.exe
*.zip
*.rar
# Flutter generated files
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/android/local.properties
mobile/android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java
mobile/ios/Flutter/Generated.xcconfig
mobile/ios/Flutter/ephemeral/
mobile/ios/Flutter/flutter_export_environment.sh
mobile/ios/Runner/GeneratedPluginRegistrant.h
mobile/ios/Runner/GeneratedPluginRegistrant.m
mobile/windows/flutter/generated_plugin_registrant.cc
mobile/windows/flutter/generated_plugin_registrant.h
mobile/windows/flutter/generated_plugins.cmake
