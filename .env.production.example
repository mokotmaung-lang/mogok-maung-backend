# ==============================================================================
# .env.production.example — production environment template for Mogok Maung.
#
# HOW THIS FILE IS USED:
#   * Committed as documentation / single source of truth for the server.
#     NEVER put real secrets here — the "CHANGE_ME_*" placeholders are replaced
#     AUTOMATICALLY with strong `openssl rand` values by scripts/prod/go-live.sh
#     when /opt/mogok-maung/.env.production is first created. You do not have to
#     invent passwords.
#   * scripts/prod/deploy-vps.sh copies this template to .env.production on
#     first boot (places the configured domain pair) and then hands off to
#     go-live.sh, which fills the secrets.
#
# NAMING NOTE: this codebase passes the API's public FQDN to the Go backend via
#   DOMAIN_NAME (CORS, webhook URLs, etc.). The SPA apex + API host pair used by
#   certbot/nginx is driven by the DOMAINS variable of scripts/prod/deploy-vps.sh
#   (default: "oddsmyanmar.online api.oddsmyanmar.online").
# ==============================================================================

# --- Database (PostgreSQL) -----------------------------------------------------
# DB_HOST/DB_PORT are used by the systemd/native run path. Inside docker compose
# the API talks to the `postgres-db` service over the internal network instead.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=bet_admin
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD     # <- auto-generated by go-live on the server
DB_NAME=myanmar_bet_prod
# TLS is MANDATORY in prod (setup-db-tls.sh enables ssl=on on postgres).
DB_SSLMODE=require

# --- API / auth ---------------------------------------------------------------
# 64 hex chars. Auto-generated by go-live: openssl rand -hex 32.
# Do NOT put a static/known value here for production.
JWT_SECRET=
# API public FQDN (THE host that serves the Go API; nginx reverse-proxies it).
# Change ONLY if you move off oddsmyanmar.online.
DOMAIN_NAME=api.oddsmyanmar.online
# API listen port (native/systemd path; compose overrides internally).
PORT=8081

# --- Realtime cache (Redis) ---------------------------------------------------
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD  # <- auto-generated on the server

# --- Settlement / agent queue (RabbitMQ) --------------------------------------
# User/pass auto-generated on the server (go-live keeps AMQP_URL in sync).
RABBITMQ_USER=CHANGE_ME_BROKER_USER
RABBITMQ_PASS=CHANGE_ME_STRONG_BROKER_PASSWORD
AMQP_URL=amqp://CHANGE_ME_BROKER_USER:CHANGE_ME_STRONG_BROKER_PASSWORD@127.0.0.1:5672/
SETTLEMENT_QUEUE=match_settlement_queue
AGENT_UNIT_REQUEST_QUEUE=agent_unit_request_queue

# --- Bootstrap SUPER_ADMIN (created once after migrations; idempotent) --------
# Password is auto-generated; the user is created by scripts/prod/bootstrap-admin.sh.
BOOT_ADMIN_USER=superadmin
BOOT_ADMIN_PASS=CHANGE_ME_BOOTSTRAP_ADMIN_PASSWORD

# --- Bot hooks (optional; leave empty to disable Viber/Telegram intake) -------
TELEGRAM_WEBHOOK_SECRET=
VIBER_AUTH_TOKEN=

# --- Admin Web (Next.js, server-side fetch) -----------------------------------
# NOTE: admin-web/lib/backend.ts reads BACKEND_URL (server-side, no trailing slash).
BACKEND_URL=https://api.oddsmyanmar.online
NEXT_PUBLIC_API_URL=https://api.oddsmyanmar.online
NEXT_PUBLIC_WS_URL=wss://api.oddsmyanmar.online