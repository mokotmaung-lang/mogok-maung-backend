# Local development environment for docker compose / docker-compose.yml
# Copy to .env and fill real values. NEVER commit the real .env.
POSTGRES_USER=bet_admin
POSTGRES_DB=myanmar_bet_prod
POSTGRES_PASSWORD=dev-only-change-me
JWT_SECRET=dev-only-secret-change-me

# RabbitMQ (settlement event queue). Defaults to guest/guest if unset.
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
SETTLEMENT_QUEUE=match_settlement_queue