# Copy to terraform.tfvars and fill real values. NEVER commit the real file.
# Secrets (DB password, JWT secret) go to SSM/Secrets Manager, not here.

region                   = "ap-southeast-1"
environment              = "prod"

vpc_id                   = "vpc-0abc1234"
private_subnet_ids       = ["subnet-0aaa1111", "subnet-0bbb2222"]
public_subnet_ids        = ["subnet-0ccc3333", "subnet-0ddd4444"]

ecr_repository_url       = "123456789012.dkr.ecr.ap-southeast-1.amazonaws.com/mm-bet-api"
image_tag                = "latest"

desired_count            = 2
min_capacity             = 2
max_capacity             = 10
cpu_scale_target         = 70
memory_scale_target      = 80

create_rds               = true
db_instance_class        = "db.r6g.large"
db_allocated_storage     = 200
db_name                  = "myanmar_bet_prod"
db_username              = "bet_admin"
backup_retention_days    = 7

create_redis             = true
redis_node_type          = "cache.t3.medium"

acm_certificate_arn      = "arn:aws:acm:ap-southeast-1:123456789012:certificate/xxxx"

# Parameter Store names holding the values at runtime (set these in AWS):
db_password_ssm          = "/mm-bet/prod/db_password"
jwt_secret_ssm           = "/mm-bet/prod/jwt_secret"