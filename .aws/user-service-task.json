{
  "family": "mm-bet-prod-user-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::000000000000:role/mm-bet-prod-ecs-execution",
  "taskRoleArn": "arn:aws:iam::000000000000:role/mm-bet-prod-ecs-task",
  "containerDefinitions": [
    {
      "name": "user-service",
      "image": "REPLACED_BY_CICD",
      "essential": true,
      "portMappings": [{ "containerPort": 8080, "hostPort": 0, "protocol": "tcp" }],
      "environment": [
        { "name": "DB_HOST", "value": "mm-bet-prod-db.cdXXXXXXXX.ap-southeast-1.rds.amazonaws.com" },
        { "name": "DB_PORT", "value": "5432" },
        { "name": "DB_USER", "value": "bet_admin" },
        { "name": "DB_NAME", "value": "myanmar_bet_prod" },
        { "name": "DB_SSLMODE", "value": "require" },
        { "name": "PORT", "value": "8080" },
        { "name": "REDIS_HOST", "value": "mm-bet-prod-redis.XXXXXXXXXX.cache.amazonaws.com" },
        { "name": "AUTO_MIGRATE", "value": "true" }
      ],
      "secrets": [
        { "name": "DB_PASSWORD", "valueFrom": "/mm-bet/prod/db_password" },
        { "name": "JWT_SECRET", "valueFrom": "/mm-bet/prod/jwt_secret" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/mm-bet-prod-user-service",
          "awslogs-region": "ap-southeast-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}